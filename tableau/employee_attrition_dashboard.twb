      <column caption='Company Attrition Rate' datatype='real' default-format='p0.0%' name='[Calculation_1631185599565826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Left (1/0)]) / COUNT([Employee ID]) }' />
      </column>
      <column caption='Employees Left' datatype='integer' default-format='n0;-0' name='[Calculation_1631185600274435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Left (1/0)])' />
      </column>
      <column caption='Attrition Rate' datatype='real' default-format='p0.0%' name='[Calculation_1631185600372741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Left (1/0)]) / COUNT([Employee ID])' />
      </column>
      <column caption='Above Company Avg' datatype='boolean' name='[Calculation_1631185600442374]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1631185600372741] &gt; MIN([Calculation_1631185599565826])' />
